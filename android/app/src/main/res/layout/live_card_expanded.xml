<?xml version="1.0" encoding="utf-8"?>
<!-- The rich live notification's expanded scoreboard (LiveCard). The whole card is colorized, so no tile or padding of
     its own: it fills the system's content column. Colors are set per light/dark theme in code. (Negative margins into
     the icon column are clipped: tried on an emulator.) Notification RemoteViews allow no Space or plain View. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/card_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:includeFontPadding="false"
                android:textSize="40sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/card_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/live_card_round"
                android:fontFamily="sans-serif-condensed"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <Chronometer
                android:id="@+id/card_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:includeFontPadding="false"
                android:textSize="44sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/card_target"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- The stage band: the iOS chevrons (asked for). Four stages, and between each pair a joint holding the earlier
         stage's arrow tip and the later one's notch, each tinted to its stage's fill (StageChevrons). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/card_seg1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/stage_body_start"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="2dp">

            <TextView
                android:id="@+id/card_seg1_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:includeFontPadding="false"
                android:letterSpacing="0.03"
                android:maxLines="1"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/card_seg1_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="sans-serif-condensed"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textSize="11sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="14dp"
            android:layout_height="match_parent">

            <FrameLayout
                android:id="@+id/card_tip1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/stage_tip" />

            <FrameLayout
                android:id="@+id/card_notch1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/stage_notch" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/card_seg2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/stage_body"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="6dp"
            android:paddingEnd="2dp">

            <TextView
                android:id="@+id/card_seg2_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:includeFontPadding="false"
                android:letterSpacing="0.03"
                android:maxLines="1"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/card_seg2_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="sans-serif-condensed"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textSize="11sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="14dp"
            android:layout_height="match_parent">

            <FrameLayout
                android:id="@+id/card_tip2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/stage_tip" />

            <FrameLayout
                android:id="@+id/card_notch2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/stage_notch" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/card_seg3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/stage_body"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="6dp"
            android:paddingEnd="2dp">

            <TextView
                android:id="@+id/card_seg3_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:includeFontPadding="false"
                android:letterSpacing="0.03"
                android:maxLines="1"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/card_seg3_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="sans-serif-condensed"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textSize="11sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="14dp"
            android:layout_height="match_parent">

            <FrameLayout
                android:id="@+id/card_tip3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/stage_tip" />

            <FrameLayout
                android:id="@+id/card_notch3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/stage_notch" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/card_seg4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/stage_body_end"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="6dp"
            android:paddingEnd="2dp">

            <TextView
                android:id="@+id/card_seg4_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:includeFontPadding="false"
                android:letterSpacing="0.03"
                android:maxLines="1"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/card_seg4_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="sans-serif-condensed"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/card_red"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="sans-serif-condensed"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/card_blue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="sans-serif-condensed"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/card_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="sans-serif-condensed"
        android:maxLines="1"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
